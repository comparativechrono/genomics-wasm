{
  "name": "genomics-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Genomics tools and DESeq2 for browsers, with native equivalence tests",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "package": "python3 scripts/package.py",
    "validate:deseq2": "node scripts/validate-deseq2.mjs",
    "package:deseq2": "python3 scripts/package-deseq2.py",
    "validate:quant": "node scripts/validate-quant.mjs",
    "package:quant": "python3 scripts/package-quant.py",
    "validate:rna-analysis": "node scripts/validate-rna-analysis.mjs",
    "package:rna-analysis": "python3 scripts/package-rna-analysis.py",
    "validate:cutadapt": "node scripts/validate-cutadapt.mjs",
    "package:cutadapt": "python3 scripts/package-cutadapt.py",
    "validate:somatic": "node scripts/validate-somatic.mjs",
    "package:somatic": "python3 scripts/package-somatic.py",
    "validate:strelka2": "node scripts/validate-strelka2.mjs",
    "package:strelka2": "python3 scripts/package-strelka2.py",
    "validate:metagenomics": "node scripts/validate-metagenomics.mjs",
    "package:metagenomics": "python3 scripts/package-metagenomics.py",
    "validate:annotation": "node scripts/validate-annotation.mjs",
    "package:annotation": "python3 scripts/package-annotation.py",
    "validate:bustools": "node scripts/validate-bustools.mjs",
    "package:bustools": "python3 scripts/package-bustools.py",
    "validate:plink2": "node scripts/validate-plink2.mjs",
    "package:plink2": "python3 scripts/package-plink2.py",
    "validate:primer3": "node scripts/validate-primer3.mjs",
    "package:primer3": "python3 scripts/package-primer3.py",
    "validate:macs3": "node scripts/validate-macs3.mjs",
    "package:macs3": "python3 scripts/package-macs3.py",
    "build:king": "python3 scripts/build-king.py all",
    "validate:king": "node scripts/validate-king.mjs",
    "test:king:demo": "node scripts/test-king-demo.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  },
  "engines": {
    "node": ">=20"
  }
}
