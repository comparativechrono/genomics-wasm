--- a/easel/esl_cpu.c
+++ b/easel/esl_cpu.c
@@ -201,7 +201,12 @@
 static void 
 cpu_run_id(uint32_t eax, uint32_t ecx, uint32_t *abcd)
 {
-#if defined(_MSC_VER)
+#if defined(__EMSCRIPTEN__)
+  /* This build requires WebAssembly SIMD. Its SSE2 intrinsics are lowered
+   * by Emscripten; x86 CPUID instructions do not exist in WebAssembly. */
+  abcd[0] = abcd[1] = abcd[2] = abcd[3] = 0;
+  if (eax == 1) abcd[3] = (1u << 25) | (1u << 26);
+#elif defined(_MSC_VER)
   __cpuidex(abcd, eax, ecx);
 #else
   uint32_t ebx = 0;
--- a/config.sub
+++ b/config.sub
@@ -1390,7 +1390,7 @@
 	      | -powermax* | -dnix* | -nx6 | -nx7 | -sei* | -dragonfly* \
 	      | -skyos* | -haiku* | -rdos* | -toppers* | -drops* | -es* \
 	      | -onefs* | -tirtos* | -phoenix* | -fuchsia* | -redox* | -bme* \
-	      | -midnightbsd*)
+	      | -midnightbsd* | -emscripten*)
 	# Remember, each alternative MUST END IN *, to match a version number.
 		;;
 	-qnx*)
--- a/src/impl_sse/p7_oprofile.c
+++ b/src/impl_sse/p7_oprofile.c
@@ -668,8 +668,10 @@
 {
   uint8_t b;
 
+  /* As in upstream impl_vmx: convert via int so negative rounded costs
+   * wrap to uint8_t portably instead of an undefined float-to-byte cast. */
   sc  = -1.0f * roundf(om->scale_b * sc);                          /* ugh. sc is now an integer cost represented in a float...           */
-  b   = (sc > 255 - om->bias_b) ? 255 : (uint8_t) sc + om->bias_b; /* and now we cast, saturate, and bias it to an unsigned char cost... */
+  b   = (sc > 255 - om->bias_b) ? 255 : (uint8_t) (int) sc + om->bias_b; /* and now we cast, saturate, and bias it to an unsigned char cost... */
   return b;
 }
  
@@ -685,7 +687,7 @@
   uint8_t b;
 
   sc  = -1.0f * roundf(om->scale_b * sc);       /* ugh. sc is now an integer cost represented in a float...    */
-  b   = (sc > 255.) ? 255 : (uint8_t) sc;	/* and now we cast and saturate it to an unsigned char cost... */
+  b   = (sc > 255.) ? 255 : (uint8_t) (int) sc;	/* and now we cast and saturate it to an unsigned char cost... */
