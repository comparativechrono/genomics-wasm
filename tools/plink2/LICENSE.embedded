#include <string.h>

#ifdef __cplusplus
namespace plink2 {
#endif

// Portable "double-double" and "triple-double" operations, primarily
// supporting high-accuracy log-likelihood calculations, based on a subset of
// the QD library (https://github.com/BL-highprecision/QD ).  See LICENSE.QD
// for that library's BSD-3-Clause-LBNL license.

const td_real _tdr_e = {{2.718281828459045091e+00, 1.445646891729250158e-16, -2.127717108038176765e-33}};
const td_real _tdr_log2 = {{6.931471805599452862e-01, 2.319046813846299558e-17, 5.707708438416212066e-34}};
const td_real _tdr_log05 = {{-6.931471805599452862e-01, -2.319046813846299558e-17, -5.707708438416212066e-34}};
static const td_real _tdr_half_log_2pi = {{9.1893853320467278056e-01, -3.8782941580672414498e-17, -1.3239715968498069736e-33}};

// Euler-Maclaurin log-factorial asymptotic-series coefficients for x^{-1},
// x^{-3}, x^{-5}, etc.:
//   +1/12, -1/360, +1/1260, -1/1680, +1/1188, -691/360360, +1/156,
//   -3617/122400, +43867/244188
// First omitted term is (-174611/125400)x^19.  For x >= 256, this is
// between 2^{-151} and 2^{-152}.
static const td_real _tdr_lfact_coeffs[9] = {
  {8.3333333333333328707e-02,  4.6259292692714853283e-18, 2.5679065925163143282e-34},
  {-2.7777777777777778838e-03,  1.0601087908747154118e-19, 3.4773735106991755191e-36},
  {7.9365079365079365011e-04,  6.8838233173682821147e-22, 5.9707649565576508289e-40},
  {-5.9523809523809529179e-04,  5.3693821875472602376e-20, -1.8342189946545105017e-36},
  {8.4175084175084171397e-04,  3.6870174889237693563e-20, -6.8899008953247077636e-37},
  {-1.9175269175269176337e-03,  1.0675702776872474941e-19, 6.5683424954265538256e-37},
  {6.4102564102564100340e-03,  2.2240044563805217184e-19, 1.9753127634740879859e-35},
  {-2.9550653594771242316e-02,  4.8617609575088553068e-19, 1.3166815175353259220e-35},
  {1.7964437236883057381e-01, -6.4016004827109457991e-19, 9.7799774396783318508e-36}
};

// All entries currently used by ddr_expm1().
CONSTI32(_tdr_n_inv_fact, 15);

static const td_real _tdr_inv_fact_offset3[_tdr_n_inv_fact] = {
  { 1.66666666666666657e-01,  9.25185853854297066e-18,  5.13581318503262866e-34},
  { 4.16666666666666644e-02,  2.31296463463574266e-18,  1.28395329625815716e-34},
  { 8.33333333333333322e-03,  1.15648231731787138e-19,  1.60494162032269652e-36},
  { 1.38888888888888894e-03, -5.30054395437357706e-20, -1.73868675534958776e-36},
  { 1.98412698412698413e-04,  1.72095582934207053e-22,  1.49269123913941271e-40},
  { 2.48015873015873016e-05,  2.15119478667758816e-23,  1.86586404892426588e-41},
  { 2.75573192239858925e-06, -1.85839327404647208e-22,  8.49175460488199287e-39},
