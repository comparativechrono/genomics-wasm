 #ifndef KRAKEN2_OMP_HACK_H_
 #define KRAKEN2_OMP_HACK_H_
+
+#include <cstdlib>
+#include <cerrno>
+#include <err.h>
+#include <sysexits.h>
+
+inline void kraken2_browser_single_thread(const char *value) {
+  char *end = nullptr;
+  errno = 0;
+  long requested = strtol(value, &end, 10);
+  if (errno == ERANGE || end == value || *end || requested != 1)
+    errx(EX_USAGE, "Kraken2 browser package requires exactly one thread");
+}
 
