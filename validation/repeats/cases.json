    {
      "id": "synthetic-male-chain",
      "kind": "success",
      "description": "Known diploid normal and expanded repeats plus male haploid X; complete calling, indexed BAMlet and visualization chain.",
      "inputs": [
        {
          "source": "common/reference.fa",
          "as": "reference.fa"
        },
        {
          "source": "common/reference.fa.fai",
          "as": "reference.fa.fai"
        },
        {
          "source": "common/reads.bam",
          "as": "reads.bam"
        },
        {
          "source": "common/reads.bam.bai",
          "as": "reads.bam.bai"
        },
        {
          "source": "common/truth.json",
          "as": "truth.json"
        },
        {
          "source": "common/catalog.json",
          "as": "catalog.json"
        }
      ],
      "steps": [
        {
          "tool": "expansionhunter",
          "args": [
            "--reads",
            "reads.bam",
            "--reference",
            "reference.fa",
            "--variant-catalog",
            "catalog.json",
            "--output-prefix",
            "eh",
            "--threads",
            "1",
            "--analysis-mode",
            "seeking",
            "--sex",
            "male"
          ],
          "outputs": [
            "eh.json",
            "eh.vcf",
            "eh_realigned.bam"
          ]
        },
        {
          "tool": "samtools",
          "args": [
            "sort",
            "--no-PG",
            "-o",
            "eh.sorted.bam",
            "eh_realigned.bam"
          ],
          "outputs": [
            "eh.sorted.bam"
          ]
        },
        {
          "tool": "samtools",
          "args": [
            "index",
            "eh.sorted.bam"
          ],
          "outputs": [
            "eh.sorted.bam.bai"
          ]
        },
        {
          "tool": "reviewer",
          "args": [
            "--reads",
            "eh.sorted.bam",
            "--vcf",
            "eh.vcf",
            "--reference",
            "reference.fa",
            "--catalog",
            "catalog.json",
            "--locus",
            "NORMAL_CAG,EXPANDED_CAG,X_CAG",
            "--output-prefix",
            "review"
          ],
          "outputs": [
            "review.NORMAL_CAG.svg",
            "review.EXPANDED_CAG.svg",
            "review.X_CAG.svg",
            "review.metrics.tsv",
            "review.phasing.tsv"
          ]
        }
      ],
      "artifacts": [
        {
          "path": "eh.json",
          "kind": "json",
          "contract": {
            "repeatTruth": {
              "source": "truth.json",
              "loci": [
                "NORMAL_CAG",
                "EXPANDED_CAG",
                "X_CAG"
              ]
            }
          }
        },
        {
          "path": "eh.vcf",
          "kind": "vcf",
          "contract": {
            "minimumRecords": 3
          }
        },
        {
          "path": "eh_realigned.bam",
          "kind": "bam",
          "contract": {
            "minimumRecords": 1,
            "graphLoci": [
              "NORMAL_CAG",
              "EXPANDED_CAG",
              "X_CAG"
            ]
          }
        },
        {
          "path": "eh.sorted.bam",
          "kind": "bam",
          "contract": {
            "coordinateSorted": true,
            "graphLoci": [
              "NORMAL_CAG",
              "EXPANDED_CAG",
              "X_CAG"
            ]
          }
        },
        {
          "path": "review.NORMAL_CAG.svg",
          "kind": "svg",
          "contract": {
            "svgMinimumElements": 50
          }
        },
        {
          "path": "review.EXPANDED_CAG.svg",
          "kind": "svg",
          "contract": {
            "svgMinimumElements": 50
          }
        },
        {
          "path": "review.X_CAG.svg",
          "kind": "svg",
          "contract": {
            "svgMinimumElements": 50
          }
        },
        {
          "path": "review.metrics.tsv",
          "kind": "tsv",
          "contract": {
            "tsvHeader": [
              "VariantId",
              "Genotype",
              "AlleleDepth"
            ],
            "tsvMinimumRows": 3
          }
        },
        {
          "path": "review.phasing.tsv",
          "kind": "tsv",
          "contract": {
            "tsvHeader": [
              "LocusId",
              "Diplotype",
              "Score"
            ],
            "tsvMinimumRows": 3
          }
        }
      ]
    },
