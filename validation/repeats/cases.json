{
  "schema": 1,
  "tool": "repeats",
  "versions": {
    "expansionhunter": "5.0.0",
    "reviewer": "0.2.7",
    "samtools": "1.21"
  },
  "runtime": [
    "runtime/index.mjs",
    "runtime/worker.mjs",
    "runtime/execute.mjs",
    "runtime/repeats.mjs"
  ],
  "cases": [
    {
      "id": "upstream-seeking",
      "kind": "success",
      "description": "Pinned upstream compound SNP and repeat: independent 0/1 and 2/10 genotypes, seeking input.",
      "inputs": [
        {
          "source": "upstream/expansionhunter/reference.fa",
          "as": "reference.fa"
        },
        {
          "source": "upstream/expansionhunter/reference.fa.fai",
          "as": "reference.fa.fai"
        },
        {
          "source": "upstream/expansionhunter/variants.bam",
          "as": "variants.bam"
        },
        {
          "source": "upstream/expansionhunter/variants.bam.bai",
          "as": "variants.bam.bai"
        },
        {
          "source": "upstream/expansionhunter/variants.json",
          "as": "variants.json"
        }
      ],
      "steps": [
        {
          "tool": "expansionhunter",
          "args": [
            "--reads",
            "variants.bam",
            "--reference",
            "reference.fa",
            "--variant-catalog",
            "variants.json",
            "--output-prefix",
            "eh",
            "--threads",
            "1",
            "--analysis-mode",
            "seeking",
            "--sex",
            "male"
          ],
          "outputs": [
            "eh.json",
            "eh.vcf",
            "eh_realigned.bam"
          ]
        }
      ],
      "artifacts": [
        {
          "path": "eh.json",
          "kind": "json",
          "contract": {
            "jsonPaths": {
              "/LocusResults/SNV_AND_STR/AlleleCount": 2,
              "/LocusResults/SNV_AND_STR/Variants/SNV_AND_STR_chr1:2000-2001/Genotype": "0/1",
              "/LocusResults/SNV_AND_STR/Variants/SNV_AND_STR_chr1:2005-2008/Genotype": "2/10"
            }
          }
        },
        {
          "path": "eh.vcf",
          "kind": "vcf",
          "contract": {
            "vcfGenotypes": {
              "SNV_AND_STR_chr1:2000-2001": {
                "GT": "0/1"
              },
              "SNV_AND_STR_chr1:2005-2008": {
                "REPCN": "2/10"
              }
            }
          }
        },
        {
          "path": "eh_realigned.bam",
          "kind": "bam",
          "contract": {
            "minimumRecords": 1,
            "graphLoci": [
              "SNV_AND_STR"
            ]
          }
        }
      ]
    },
